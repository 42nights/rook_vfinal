# --- Convex (required for Vercel deployment) ----------------------------------
# Hosted Convex deployment — replaces local SQLite.
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# --- Rook configuration ------------------------------------------------------
# "cloud" runs ALL reasoning (threat model, vuln scan, exploit synthesis,
# enrichment, judge) on the Anthropic API. Rook has no embeddings, so cloud mode
# needs nothing local. "local" routes to an on-device model for zero cloud touch.
ROOK_MODE=cloud
ANTHROPIC_API_KEY=
# A scan makes many LLM calls — sonnet is much faster/cheaper than opus:
# GENERATION_MODEL=claude-sonnet-4-6

# Local LLM (used only when ROOK_MODE=local; OpenAI-compatible :1234 / :11434/v1)
LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=qwen/qwen3.5-9b

# Exploits run as STRUCTURED HTTP requests host-locked to the scan target — no
# host shell, no host process, in any mode. Nothing to configure here.

# Cap how many ranked candidates get the exploit-synthesis treatment per scan.
ROOK_MAX_FINDINGS=12

# Supply-chain: allow api.osv.dev through the local guard for dependency vulns.
ROOK_OSV=false

# --- GitHub App (optional) — install on a repo to scan on push + open issues ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/secrets/app.pem
# GITHUB_WEBHOOK_SECRET=
# GITHUB_TOKEN=        # personal token alternative for opening issues

# --- Integrations ------------------------------------------------------------
# OTIS_URL=            # Otis base URL — wires the "Send to Otis" fix loop
# SLACK_WEBHOOK_URL=   # finding notifications

# --- Castle template deployment (optional — no-op when unset) ----------------
# ROOK_TENANT_SLUG=          # e.g. "acme" — activates tenant mode
# ROOK_TENANT_DISPLAY_NAME=  # UI name replacing "Rook" (default: "Rook")
# ROOK_TENANT_PUBLIC_URL=    # public base URL of this deployment
# ROOK_LOGO_URL=             # favicon override URL
# ROOK_PRIMARY_COLOR=        # CSS color for --accent override (e.g. "#4f46e5")
# CASTLE_DEPLOYMENT_ID=      # Castle deployment ID for event backlink
# CASTLE_API_URL=            # Castle API base URL
# CASTLE_WEBHOOK_SECRET=     # Shared secret for x-castle-secret header
# ROOK_DAILY_BUDGET_USD=50   # Daily LLM spend cap (default 50); set 0 to disable all scans

# --- Security / deployment ---------------------------------------------------
# Rook's API is unauthenticated by default (local-first, single-user/trusted
# network). When the deployment is network-reachable, set ROOK_API_SECRET to
# require a bearer token on the write APIs (/api/scan, findings replay/otis) —
# callers must send `Authorization: Bearer <secret>` (or `x-rook-secret`). Unset
# = open (local default); set = fail-closed.
# ROOK_API_SECRET=
#   - /api/scan clones + RUNS the target app's start command. Safe defaults:
#   - Local-path scanning is BLOCKED from the API unless allowlisted (the CLI
#     `npm run scan` is unaffected):
# ROOK_LOCAL_ROOTS=/srv/repos
#   - Exploits are host-locked HTTP requests (no host shell), always safe.
#   - The DYNAMIC phase RUNS the target repo's start command on the host
#     (install is --ignore-scripts; the child gets a minimal PATH, no secrets,
#     an ephemeral home; obviously-malicious start scripts are refused). For
#     fully-untrusted repos run Rook in a disposable container/VM, or disable the
#     host start entirely with ROOK_SANDBOX=off (static + exploit phases still run).
# ROOK_SANDBOX=local        # local (guarded host subprocess) | docker | off
#   - Concurrent scans + exploit budget are capped:
# ROOK_MAX_CONCURRENT_SCANS=3
# ROOK_MAX_FINDINGS=12
# ROOK_CORPUS_MAX_CHARS=40000
# LLM_TIMEOUT_MS=180000
