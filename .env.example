# --- Rook configuration ------------------------------------------------------
# Local-first by default: no outbound model API calls. Leave ROOK_MODE=local.
ROOK_MODE=local

# Local LLM (OpenAI-compatible: LM Studio :1234, Ollama :11434/v1)
LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=qwen/qwen3.5-9b

# Power users: ROOK_MODE=cloud uses Anthropic for higher-quality reasoning on the
# harder bugs. Off by default. Requires ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=

# Exploits run as STRUCTURED HTTP requests host-locked to the scan target — no
# host shell, no host process, in any mode. Nothing to configure here.

# Cap how many ranked candidates get the exploit-synthesis treatment per scan.
ROOK_MAX_FINDINGS=12

# Supply-chain: allow api.osv.dev through the local guard for dependency vulns.
ROOK_OSV=false

# --- GitHub App (optional) — install on a repo to scan on push + open issues ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/secrets/app.pem
# GITHUB_WEBHOOK_SECRET=
# GITHUB_TOKEN=        # personal token alternative for opening issues

# --- Integrations ------------------------------------------------------------
# OTIS_URL=            # 42n-bot base URL — wires the "Send to Otis" fix loop
# SLACK_WEBHOOK_URL=   # finding notifications

# --- Security / deployment ---------------------------------------------------
# Rook's API is UNAUTHENTICATED by design (local-first, single-user/trusted
# network). Do NOT expose it publicly without an authenticating reverse proxy —
# /api/scan clones + RUNS the target app's start command. Safe defaults:
#   - Local-path scanning is BLOCKED from the API unless allowlisted (the CLI
#     `npm run scan` is unaffected):
# ROOK_LOCAL_ROOTS=/srv/repos
#   - Exploits are host-locked HTTP requests (no host shell), always safe.
#   - The DYNAMIC phase still RUNS the target repo's start command on the host
#     (install is --ignore-scripts; the child gets a minimal PATH, no secrets,
#     and an ephemeral home). For fully-untrusted repos, run Rook itself inside a
#     disposable container/VM so a malicious start script is contained.
#   - Concurrent scans + exploit budget are capped:
# ROOK_MAX_CONCURRENT_SCANS=3
# ROOK_MAX_FINDINGS=12
# ROOK_CORPUS_MAX_CHARS=40000
# LLM_TIMEOUT_MS=180000
